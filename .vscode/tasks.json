{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "SimOps: verify",
      "type": "shell",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "scripts/verify.ps1"],
      "group": {"kind": "test", "isDefault": true},
      "problemMatcher": []
    },
    {
      "label": "SimOps: run demo",
      "type": "shell",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "scripts/run-demo.ps1"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "SimOps: dashboard",
      "type": "shell",
      "command": "python",
      "args": ["-m", "simops_studio", "dashboard", "examples/project.yaml"],
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
